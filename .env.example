SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# LINE Login — from LINE Developers console (https://developers.line.biz)
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# Google Sign-In (Web) — from Google Cloud Console → APIs & Services → Credentials
# Create an "OAuth 2.0 Client ID" of type "Web application"
# Add your domain to "Authorized JavaScript origins" (e.g. https://yourdomain.com)
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# Firebase Web Push VAPID key — generate at:
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
FCM_WEB_VAPID_KEY=your-vapid-key-from-firebase-console

# AdMob — replace with real Ad Unit IDs from AdMob console (https://admob.google.com)
# Create a Banner Ad Unit for Android and iOS separately
# Also register your app in AdMob and add your AdMob App ID to:
#   Android: android/app/src/main/AndroidManifest.xml (com.google.android.gms.ads.APPLICATION_ID)
#   iOS: ios/Runner/Info.plist (GADApplicationIdentifier)
ADMOB_BANNER_ANDROID=your-android-ad-unit-id
ADMOB_BANNER_IOS=your-ios-ad-unit-id

# Google AdSense — from adsense.google.com
ADSENSE_PUBLISHER_ID=your-adsense-publisher-id
ADSENSE_SLOT_ID=your-adsense-slot-id
