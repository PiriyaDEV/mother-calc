SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# LINE Login — from LINE Developers console (https://developers.line.biz)
LINE_CHANNEL_ID=your-line-channel-id

# Google Sign-In — from Google Cloud Console (APIs & Services → Credentials)
# iOS Client ID — paste into ios/Runner/Info.plist (GIDClientID + reversed URL scheme)
# Android Client ID — register package name + SHA-1 in Google Cloud Console, no file needed
# No env key needed — Google login uses the same fake email pattern as LINE
